# ---------------------------------------------------------------------------
# Base de datos
# Dev: SQLite local. Producción: Postgres (Neon, Supabase, Railway, RDS...).
#   postgresql://usuario:pass@host:5432/soja?sslmode=require
# Si cambiás a Postgres, actualizá también `provider` en prisma/schema.prisma
# y el adapter en src/server/db.ts.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Sitio
# URL pública, usada para los back_urls y el webhook de Mercado Pago.
# En producción tiene que ser https y accesible desde internet.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Mercado Pago (Checkout Pro)
# Credenciales: https://www.mercadopago.com.ar/developers/panel/app
# Usá las de TEST hasta que el flujo esté validado.
# Si MP_ACCESS_TOKEN queda vacío, la app corre en modo simulado: crea el
# pedido y lo marca como pago sin ir a Mercado Pago (para probar sin cuenta).
# ---------------------------------------------------------------------------
MP_ACCESS_TOKEN=""
NEXT_PUBLIC_MP_PUBLIC_KEY=""
# Clave secreta del webhook (panel > Webhooks > Firma secreta). Si está vacía
# no se valida la firma; en producción es obligatoria.
MP_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Almacenamiento de arte y mockups
# local  -> public/uploads (solo dev; en Vercel el filesystem es efímero)
# s3     -> ver src/server/storage.ts para completar el adapter
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"

# ---------------------------------------------------------------------------
# Panel de administración (/admin)
# Sin contraseña el panel no se puede abrir.
#   Dev: alcanza con ADMIN_PASSWORD en texto plano.
#   Producción: generá el hash con `npm run admin:hash -- "tu contraseña"`,
#   cargalo en ADMIN_PASSWORD_HASH y borrá ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET firma la cookie de sesión. Si lo dejás vacío se deriva
# de la contraseña, así cambiarla cierra todas las sesiones abiertas.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD="cambiala-ya"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Operación
# Estos son los valores por defecto: una vez que los tocás desde /admin/config
# manda lo que quedó guardado en la base.
# ---------------------------------------------------------------------------
SOJA_SHIPPING_FLAT=6500
SOJA_FREE_SHIPPING_FROM=250000
SOJA_ORDER_EMAIL="pedidos@soja.com.ar"
SOJA_WHATSAPP=""
SOJA_PICKUP_ADDRESS=""
SOJA_LEAD_TIME_DAYS=7
